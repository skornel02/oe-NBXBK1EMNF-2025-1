<div class="taskbar">
	<button class="start-button">
		<div class="start-logo"></div>
		<span>start</span>
	</button>
	<div class="quick-launch">
		<svg class="quick-launch-icon" viewBox="0 0 16 16" fill="white">
			<rect width="14" height="11" x="1" y="2" rx="1" stroke="black" stroke-width="0.5" />
			<rect width="10" height="7" x="3" y="4" fill="lightblue" />
		</svg>
		<svg class="quick-launch-icon" viewBox="0 0 16 16" fill="#0078d7">
			<circle cx="8" cy="8" r="7" stroke="navy" stroke-width="0.5" />
			<path d="M6 8 L10 5 L10 11 Z" fill="gold" />
		</svg>
	</div>

	<div class="task-items">
		<div class="task-item">
			<svg class="task-icon" viewBox="0 0 16 16">
				<rect width="12" height="10" x="2" y="3" fill="#0078d7" stroke="navy" stroke-width="0.5" />
				<rect width="8" height="6" x="4" y="5" fill="lightblue" />
			</svg>
			<span>Messages</span>
		</div>
		<div class="task-item">
			<svg class="task-icon" viewBox="0 0 16 16">
				<circle cx="8" cy="8" r="7" fill="#0078d7" stroke="navy" stroke-width="0.5" />
				<text x="8" y="11" font-size="10" fill="white" text-anchor="middle" font-weight="bold">c</text>
			</svg>
			<span>Control Panel</span>
		</div>
	</div>

	<div class="system-tray">
		<svg class="tray-icon" viewBox="0 0 16 16" fill="white">
			<rect width="2" height="8" x="2" y="6" />
			<rect width="2" height="6" x="5" y="8" />
			<rect width="2" height="10" x="8" y="4" />
			<rect width="2" height="7" x="11" y="7" />
		</svg>
		<svg class="tray-icon" viewBox="0 0 16 16" fill="#ffd700">
			<polygon points="8,2 10,6 14,6 11,9 12,13 8,10 4,13 5,9 2,6 6,6" />
		</svg>
		<span class="clock" id="clock">1:25 PM</span>
	</div>
</div>

<script>
	function updateClock() {
		const now = new Date();
		const hours = now.getHours() % 12 || 12;
		const minutes = now.getMinutes().toString().padStart(2, '0');
		const ampm = now.getHours() >= 12 ? 'PM' : 'AM';
		document.getElementById('clock').textContent = `${hours}:${minutes} ${ampm}`;
	}
	updateClock();
	setInterval(updateClock, 1000);
</script>

