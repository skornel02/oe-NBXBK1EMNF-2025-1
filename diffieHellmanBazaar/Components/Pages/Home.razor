@page "/"
@using diffieHellmanBazaar.Models
@using diffieHellmanBazaar.Services
@inject IJSRuntime js
@inject BazaarService bazaarService
@inject EncryptionService encryptionService

<PageTitle>Home</PageTitle>

<div class="d-flex flex-column vh-100 p-5 gap-3" id="page">
	<div class="window d-flex flex-column h-50" id="messages-window" style="margin-left: -1rem;">
		<div class="title-bar">
			<div class="title-bar-text">Messages</div>
			<div class="title-bar-controls">
				<button aria-label="Help"></button>
				<button id="messages-window-toggle" aria-label="Maximize" onclick="toggleMessagesFullscreen()"></button>
				<button aria-label="Close" disabled style="cursor: not-allowed;"></button>
			</div>
		</div>
		<div class="window-body flex-grow-1 ps-2 overflow-y-auto">
			Kornél Stefán&#10094;R&#10095; Bazaar DOS
			&#10094;C&#10095; Copyright Introduction to cybersecurity 2025-26/1.
			<br />
			<br />
			@foreach (var message in _messages)
			{
				<BazaarMessageItem Message="message"
								   EncryptionService="encryptionService"
								   SecretKeys="_knownSecrets"
								   OnPairRequest="SendPairResponseMessage"
								   OnPairResponse="SendPairAcceptedMessage" />
			}
			@if (_messages.Count == 0)
			{
				<p>
					There are no messages yet...
				</p>
			}
		</div>
	</div>

	<div class="window d-flex flex-column h-50" id="control-window" style="margin-right: -1rem; max-width: 600px;">
		<div class="title-bar">
			<div class="title-bar-text">Control Panel</div>
			<div class="title-bar-controls">
				<button aria-label="Help"></button>
				<button id="control-window-toggle" aria-label="Maximize" onclick="toggleControlFullscreen()"></button>
				<button aria-label="Close"></button>
			</div>
		</div>
		<div class="window-body overflow-y-auto">
			<menu role="tablist" class="">
				<button aria-selected="@(_selectedTab == "send-message" ? "true" : "false")"
						@onclick='() => _selectedTab = "send-message"'
						aria-controls="send-message">
					Send message
				</button>
				<button aria-selected="@(_selectedTab == "friends" ? "true" : "false")"
						@onclick='() => _selectedTab = "friends"'
						aria-controls="friends">
					Friends
				</button>
				<button aria-selected="@(_selectedTab == "settings" ? "true" : "false")"
						@onclick='() => _selectedTab = "settings"'
						aria-controls="settings">
					Settings
				</button>
			</menu>
			<article role="tabpanel" id="send-message" hidden="@(_selectedTab != "send-message")">
				@if (_loginModel is null)
				{
					<p>Before you can send messages please log in.</p>
					<fieldset>
						<legend>Who are you?</legend>
						<div>
							<label>Username:</label>
							<input @bind="_username" class="w-100" style="max-width: 300px;" />
						</div>
					</fieldset>
					<section class="field-row">
						<button @onclick="LoginUser">Login</button>
					</section>
				}
				else
				{
					<p>Send a message!</p>
					<fieldset>
						<div class="field-row-stacked" style="width: 200px">
							<label for="messagebox">Text message</label>
							<textarea id="messagebox" rows="4" @bind="_message" class="w-100"></textarea>
						</div>
					</fieldset>
					<fieldset>
						<div class="field-row-stacked" style="width: 200px">
							<label for="fileupload">Attach file (optional)</label>
							<input type="file" id="fileupload" />
						</div>
					</fieldset>
					<fieldset>
						<div class="field-row-stacked" style="width: 200px">
							<label for="messagebox">Target</label>
							<select @bind="_selectedSecret">
								<option value="" selected>Everyone</option>
								@foreach (var (id, secret) in _knownSecrets)
								{
									<option value="@id">@secret.FriendName (#@secret.SequenceNumber)</option>
								}
							</select>
						</div>
					</fieldset>
					<section class="field-row">
						<button @onclick="SendBazaarMessage">Send</button>
					</section>

					<section class="field-row">
						<button @onclick="SendPairRequestMessage">Send Friend Request</button>
					</section>
				}
			</article>

			<article role="tabpanel" id="friends" hidden="@(_selectedTab != "friends")">
				@if (_loginModel is null)
				{
					<p>Please sign in before you access your friends.</p>
				}
				else
				{
					<p>Your friend connections:</p>
					<ul class="tree-view">
						@foreach (var(id, secret) in _knownSecrets)
						{
							<li>@secret.FriendName (#@secret.SequenceNumber)</li>
						}
						@if (_knownSecrets.Count == 0)
						{
							<li class="fst-italic">You have no friends!</li>
						}
					</ul>
				}
			</article>

			<article role="tabpanel" id="settings" hidden="@(_selectedTab != "settings")">
				@if (_loginModel is not null)
				{
					<p class="my-2">Your information</p>
					<fieldset>
						<p class="m-0">User Id</p>
						<p style="font-style: italic;">@_loginModel.IdString</p>
						<p class="m-0">Secret</p>
						<p style="font-style: italic;">@_loginModel.SecretText</p>
					</fieldset>

					<section class="field-row">
						<button @onclick="(() => _loginModel = null)" class="me-1">Logout</button>
						Sign out of account
					</section>
				}
			</article>
		</div>
	</div>

	<TaskBar />
</div>

@if (errorMessage is not null)
{
	<MessageDialog Message="@errorMessage"
				   Type="MessageDialog.DialogType.Error"
				   HandleClose="() => errorMessage = null"
				   HandleOk="() => errorMessage = null" />
}

<script>
	function toggleMessagesFullscreen() {
		const messageWindow = document.getElementById("messages-window");
		if (document.fullscreenElement){
			document.exitFullscreen();
		} else if (messageWindow.requestFullscreen) {
			messageWindow.requestFullscreen();
		}
	}
	function toggleControlFullscreen() {
		const controlWindow = document.getElementById("control-window");
		if (document.fullscreenElement){
			document.exitFullscreen();
		} else if (controlWindow.requestFullscreen) {
			controlWindow.requestFullscreen();
		}
	}
	function scrollToBottomMessage() {
		const messageWindow = document.querySelector("#messages-window .window-body");
		messageWindow.scroll(0, messageWindow.scrollHeight);
	}

	addEventListener('fullscreenchange', (e) => {
		const icon = document.fullscreenElement ? "Restore" : "Maximize";
		const messageWindow = document.getElementById("messages-window-toggle");
		messageWindow.setAttribute('aria-label', icon);
		const controlWindow = document.getElementById("control-window-toggle");
		controlWindow.setAttribute('aria-label', icon);
		console.log(icon)
	});
</script>

@code {
	private string _selectedTab = "send-message";
	private List<BazaarMessage> _messages = [];

	private string _username = string.Empty;
	private LoginModel? _loginModel;

	private string _message = string.Empty;
	private string? _fileId;
	private Guid? _selectedSecret;

	private string? errorMessage;

	private Dictionary<Guid, BazaarSecretExchange> _knownSecrets = new();

	protected override async Task OnInitializedAsync()
	{
		bazaarService.OnMessageReceived += ReceiveBazaarMessage;
	}

	public void LoginUser()
	{
		if (_loginModel is not null)
		{
			return;
		}

		if (string.IsNullOrWhiteSpace(_username))
		{
			errorMessage = "Please input a username!";
			return;
		}

		if (!_username.All(_ => char.IsLetterOrDigit(_)))
		{
			errorMessage = "Your username must only contain letters and numbers!";
			return;
		}

		_loginModel = new()
		{
			Username = _username
		};
	}

	public void SendBazaarMessage()
	{
		if (_loginModel is null)
		{
			return;
		}

		if (string.IsNullOrWhiteSpace(_message))
		{
			errorMessage = "Your message cannot be empty!";
			return;
		}

		var message = _message;
		var encrypted = false;

		if (_selectedSecret is not null && _knownSecrets.TryGetValue(_selectedSecret.Value, out var secret))
		{
			message = encryptionService.EncryptMessage(message, secret.CommonSecret); 
			encrypted = true;
		}

		var bazaarMessage = new BazaarMessage()
		{
			Sender = _loginModel.Username,
			SenderId = _loginModel.Id,
			Filename = _fileId,
			Message = message,
			EncryptionKeyId = encrypted ? _selectedSecret : null,
		};
		_message = "";

		bazaarService.SendMessage(bazaarMessage);
	}

	public void SendPairRequestMessage()
	{
		if (_loginModel is null)
		{
			return;
		}
		var pairMessage = new BazaarMessage()
		{
			Sender = _loginModel.Username,
			SenderId = _loginModel.Id,
			Filename = null,
			Message = $"Hello, my name is {_loginModel.Username} and I would like to make friends!",
			PairRequest = new(_loginModel.Secret),
		};
		bazaarService.SendMessage(pairMessage);
	}

	public void SendPairResponseMessage(BazaarMessage request)
	{
		if (_loginModel is null || request.PairRequest is null)
		{
			return;
		}

		var pairResponse = new BazaarPairResponse(request.PairRequest!, _loginModel.Secret);
		var message = $"Hello {request.Sender}, I am {_loginModel.Username} and I would like to be your friend!";

		var secretExchange = new BazaarSecretExchange()
		{
			CommonSecret = pairResponse.ComputeResponderSharedSecret(_loginModel.Secret),
			FriendName = request.Sender,
			SequenceNumber = _knownSecrets.Count + 1,
		};

		var pairMessage = new BazaarMessage()
		{
			Sender = _loginModel.Username,
			SenderId = _loginModel.Id,
			Message = encryptionService.EncryptMessage(message, secretExchange.CommonSecret),
			PairResponse = pairResponse,
		};
		pairMessage.EncryptionKeyId = pairMessage.Id;

		_knownSecrets[pairMessage.Id] = secretExchange;

		bazaarService.SendMessage(pairMessage);
	}


	public void SendPairAcceptedMessage(BazaarMessage response)
	{
		if (_loginModel is null || response.PairResponse is null)
		{
			return;
		}

		var message = $"It is nice to meet you {response.Sender}!";

		var secretExchange = new BazaarSecretExchange()
		{
			CommonSecret = response.PairResponse.ComputeRequesterSharedSecret(_loginModel.Secret),
			FriendName = response.Sender,
			SequenceNumber = _knownSecrets.Max(_ => (int?)_.Value.SequenceNumber) ?? 0 + 1,
		};

		_knownSecrets[response.Id] = secretExchange;

		var pairMessage = new BazaarMessage()
		{
			Sender = _loginModel.Username,
			SenderId = _loginModel.Id,
			Message = encryptionService.EncryptMessage(message, secretExchange.CommonSecret),
			EncryptionKeyId = response.Id,
		};

		bazaarService.SendMessage(pairMessage);
	}

	public void ReceiveBazaarMessage(BazaarMessage message)
		=> InvokeAsync(() =>
		{
			_messages.Add(message);
			StateHasChanged();
		});
}